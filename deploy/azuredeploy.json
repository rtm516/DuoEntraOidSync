{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Provisions the Duo-Entra oid alias sync Function App (Consumption), storage, Application Insights, Key Vault with the Duo secrets, a system-assigned managed identity, and the Key Vault RBAC role assignment. The Microsoft Graph User.Read.All grant is a directory-plane action and must be run once by an admin after deployment (see README)."
  },
  "parameters": {
    "functionAppName": {
      "type": "string",
      "defaultValue": "",
      "maxLength": 16,
      "metadata": {
        "description": "Base name for all resources (a 6-char unique hash is appended). Leave blank to use 'duooidsync'. Max 16 chars so the derived storage and Key Vault names stay within Azure's 24-char limit."
      }
    },
    "duoIntegrationKey": {
      "type": "securestring",
      "metadata": {
        "description": "Duo Admin API integration key (ikey). Stored as a Key Vault secret."
      }
    },
    "duoSecretKey": {
      "type": "securestring",
      "metadata": {
        "description": "Duo Admin API secret key (skey). Stored as a Key Vault secret."
      }
    },
    "duoApiHost": {
      "type": "string",
      "metadata": {
        "description": "Duo API hostname, e.g. api-XXXXXXXX.duosecurity.com (no scheme). Not secret."
      }
    },
    "duoUpnAliasSlot": {
      "type": "string",
      "defaultValue": "alias1",
      "metadata": {
        "description": "Duo alias slot holding the UPN join key."
      }
    },
    "duoOidAliasSlot": {
      "type": "string",
      "defaultValue": "alias2",
      "metadata": {
        "description": "Duo alias slot the Entra oid is written to. Must differ from duoUpnAliasSlot."
      }
    },
    "dryRun": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "When true, the function logs intended writes without calling Duo. Recommended for the first run."
      }
    },
    "timerSchedule": {
      "type": "string",
      "defaultValue": "0 30 * * * *",
      "metadata": {
        "description": "NCRONTAB schedule for the Sync function. Default is half past every hour."
      }
    },
    "packageUri": {
      "type": "string",
      "defaultValue": "https://github.com/rtm516/DuoEntraOidSync/releases/latest/download/DuoEntraOidSync.zip",
      "metadata": {
        "description": "Publicly-reachable URL (or SAS) of the built function zip. The app runs from this package via WEBSITE_RUN_FROM_PACKAGE, so the deploy includes the code. A release must exist at this URL; override to pin a version or point at your own build/blob."
      }
    }
  },
  "variables": {
    "baseName": "[if(empty(parameters('functionAppName')), 'duooidsync', parameters('functionAppName'))]",
    "nameSuffix": "[substring(uniqueString(resourceGroup().id), 0, 6)]",
    "namePrefix": "[toLower(replace(variables('baseName'), '-', ''))]",
    "appName": "[concat(variables('namePrefix'), variables('nameSuffix'))]",
    "location": "[resourceGroup().location]",
    "storageAccountName": "[take(concat(variables('namePrefix'), 'st', variables('nameSuffix')), 24)]",
    "keyVaultName": "[take(concat(variables('namePrefix'), 'kv', variables('nameSuffix')), 24)]",
    "hostingPlanName": "[concat(variables('namePrefix'), 'pla', variables('nameSuffix'))]",
    "appInsightsName": "[variables('appName')]",
    "logAnalyticsName": "[concat(variables('namePrefix'), 'law', variables('nameSuffix'))]",
    "contentShareName": "[variables('appName')]",
    "duoIntegrationKeySecretName": "Duo-IntegrationKey",
    "duoSecretKeySecretName": "Duo-SecretKey",
    "keyVaultSecretsUserRoleId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '4633458b-17de-408a-b874-0445c86b69e6')]"
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[variables('location')]",
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "allowBlobPublicAccess": false,
        "supportsHttpsTrafficOnly": true
      }
    },
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2022-10-01",
      "name": "[variables('logAnalyticsName')]",
      "location": "[variables('location')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('appInsightsName')]",
      "location": "[variables('location')]",
      "kind": "web",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      ],
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('logAnalyticsName'))]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[variables('keyVaultName')]",
      "location": "[variables('location')]",
      "properties": {
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "tenantId": "[subscription().tenantId]",
        "enableRbacAuthorization": true,
        "enabledForTemplateDeployment": true,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": 7,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), variables('duoIntegrationKeySecretName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ],
      "properties": {
        "value": "[parameters('duoIntegrationKey')]"
      }
    },
    {
      "type": "Microsoft.KeyVault/vaults/secrets",
      "apiVersion": "2023-07-01",
      "name": "[format('{0}/{1}', variables('keyVaultName'), variables('duoSecretKeySecretName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]"
      ],
      "properties": {
        "value": "[parameters('duoSecretKey')]"
      }
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[variables('hostingPlanName')]",
      "location": "[variables('location')]",
      "sku": {
        "name": "Y1",
        "tier": "Dynamic"
      },
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[variables('appName')]",
      "location": "[variables('location')]",
      "kind": "functionapp",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('hostingPlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "netFrameworkVersion": "v10.0",
          "use32BitWorkerProcess": false,
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2"
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.Web/sites', variables('appName')), variables('keyVaultSecretsUserRoleId'))]",
      "scope": "[format('Microsoft.KeyVault/vaults/{0}', variables('keyVaultName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName'))]",
        "[resourceId('Microsoft.Web/sites', variables('appName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[variables('keyVaultSecretsUserRoleId')]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      }
    },
    {
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}/appsettings', variables('appName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('appName'))]",
        "[resourceId('Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), resourceId('Microsoft.Web/sites', variables('appName')), variables('keyVaultSecretsUserRoleId')))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), variables('duoIntegrationKeySecretName'))]",
        "[resourceId('Microsoft.KeyVault/vaults/secrets', variables('keyVaultName'), variables('duoSecretKeySecretName'))]",
        "[resourceId('Microsoft.Insights/components', variables('appInsightsName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ],
      "properties": {
        "AzureWebJobsStorage": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value)]",
        "WEBSITE_CONTENTAZUREFILECONNECTIONSTRING": "[concat('DefaultEndpointsProtocol=https;AccountName=', variables('storageAccountName'), ';EndpointSuffix=', environment().suffixes.storage, ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value)]",
        "WEBSITE_CONTENTSHARE": "[variables('contentShareName')]",
        "FUNCTIONS_EXTENSION_VERSION": "~4",
        "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
        "WEBSITE_RUN_FROM_PACKAGE": "[parameters('packageUri')]",
        "APPLICATIONINSIGHTS_CONNECTION_STRING": "[reference(resourceId('Microsoft.Insights/components', variables('appInsightsName')), '2020-02-02').ConnectionString]",
        "Duo__IntegrationKey": "[concat('@Microsoft.KeyVault(SecretUri=', reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri, 'secrets/', variables('duoIntegrationKeySecretName'), '/)')]",
        "Duo__SecretKey": "[concat('@Microsoft.KeyVault(SecretUri=', reference(resourceId('Microsoft.KeyVault/vaults', variables('keyVaultName')), '2023-07-01').vaultUri, 'secrets/', variables('duoSecretKeySecretName'), '/)')]",
        "Duo__ApiHost": "[parameters('duoApiHost')]",
        "Sync__DuoUpnAliasSlot": "[parameters('duoUpnAliasSlot')]",
        "Sync__DuoOidAliasSlot": "[parameters('duoOidAliasSlot')]",
        "Sync__Schedule": "[parameters('timerSchedule')]",
        "Sync__DryRun": "[if(parameters('dryRun'), 'true', 'false')]",
        "Sync__ManagedIdentityClientId": ""
      }
    }
  ],
  "outputs": {
    "functionAppName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "functionAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('appName')), '2023-12-01', 'full').identity.principalId]"
    },
    "keyVaultName": {
      "type": "string",
      "value": "[variables('keyVaultName')]"
    }
  }
}
